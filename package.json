{
  "name": "corpus",
  "private": true,
  "version": "0.1.0",
  "description": "Corpus — provenance-backed data royalties for the agent economy, on Monad",
  "type": "module",
  "scripts": {
    "chain": "anvil --block-time 1 --silent",
    "deploy:local": "bash scripts/deploy-local.sh",
    "scorer": "tsx scorer/src/index.ts",
    "web": "pnpm --filter @corpus/web dev",
    "demo": "tsx agents/src/demo.ts",
    "demo:reset": "bash scripts/reset.sh",
    "e2e": "bash scripts/e2e.sh",
    "test:contracts": "cd contracts && forge test -vv",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "viem": "^2.21.55"
  },
  "packageManager": "pnpm@10.12.1"
}

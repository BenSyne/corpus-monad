# ── Monad testnet ────────────────────────────────────────────────────────────
# Chain 10143. Faucet: https://faucet.monad.xyz  ·  Explorer: https://testnet.monadexplorer.com
NETWORK=testnet
RPC_URL=https://testnet-rpc.monad.xyz

# Contract addresses come from shared/deployments/testnet.json, which is written
# by the deploy script. Deploy once from a machine with Foundry, commit that file,
# and every other environment (Replit included) just reads it.

# ── Keys ─────────────────────────────────────────────────────────────────────
# Each role needs its own funded wallet. The scorer signs a transaction for every
# submission, so fund it best. 0.5 MON per wallet is plenty.
# NEVER commit real keys — set these as Replit Secrets, not in the repo.
PK_DEPLOYER=
PK_SCORER=
PK_HONEST_A=
PK_HONEST_B=
PK_COPYCAT=
PK_SLOPBOT=
PK_BUYER=
PK_CURATOR=

# Addresses matching the keys above (deploy needs these two explicitly)
SCORER_ADDRESS=
CURATOR_ADDRESS=

# ── Services ─────────────────────────────────────────────────────────────────
CORPUS_SCORER_API=http://127.0.0.1:8787
